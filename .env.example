# Copy to .env and fill in. Do not commit .env.

# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Google auth is ADC, not an API key. Two reasons, both hard:
#   - Cloud TTS does not accept API keys at all, on any project
#   - generativelanguage.googleapis.com is blocked by policy on the temp accounts
# So run, once per machine:
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT
#   gcloud auth application-default set-quota-project YOUR_PROJECT
#   gcloud services enable aiplatform.googleapis.com texttospeech.googleapis.com
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-2.5-flash

# Caregiver = male, senior = American female. Cloud TTS has NO en-SG voice
# (only en-AU, en-GB, en-IN, en-US), so the Singaporean-ness is in the text,
# not the accent -- see the Singlish register in agent.JIO.
# `python voice.py --list` shows everything available.
VOICE_CAREGIVER=en-AU-Chirp3-HD-Charon
VOICE_SENIOR=en-US-Chirp3-HD-Aoede

# Only used if GOOGLE_CLOUD_PROJECT is empty, and only for Gemini -- never TTS.
# Needs a project without the policy restriction.
GOOGLE_API_KEY=
